# Copy to .env and fill in. Never commit .env.

# --- PostgreSQL (app data + pgvector) ---
POSTGRES_USER=patchnote
POSTGRES_PASSWORD=change-me
POSTGRES_DB=patchnote
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Neo4j ---
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me-too
NEO4J_URI=bolt://localhost:7687

# --- Airflow (docker profile "airflow") ---
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=change-me
AIRFLOW_FERNET_KEY=
AIRFLOW_SECRET_KEY=change-me

# --- External APIs ---
# GitHub token: public-read only, no scopes. Empty = unauthenticated (60 req/h).
GITHUB_TOKEN=
# Contact string put into the User-Agent of every outgoing request.
HTTP_CONTACT=your-email@example.com

LOG_LEVEL=INFO
